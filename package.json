{
  "name": "bonvoy-monorepo",
  "version": "0.12.7",
  "private": true,
  "description": "🚢 Plugin-based release automation tool for npm packages and monorepos",
  "keywords": [
    "automation",
    "changelog",
    "cli",
    "conventional-commits",
    "git",
    "github",
    "monorepo",
    "npm",
    "plugin",
    "publish",
    "release",
    "semantic-release",
    "versioning",
    "workspace"
  ],
  "homepage": "https://github.com/Zweer/bonvoy#readme",
  "bugs": {
    "url": "https://github.com/Zweer/bonvoy/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zweer/bonvoy.git"
  },
  "license": "MIT",
  "author": {
    "name": "Zweer",
    "email": "n.olivieriachille@gmail.com"
  },
  "type": "module",
  "main": "index.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsdown",
    "postbuild": "npm run scripts:schema",
    "clean": "rimraf --glob packages/**/dist",
    "predocs:build": "tsx scripts/generate-llms-txt.ts",
    "docs:build": "astro build --root docs",
    "docs:dev": "astro dev --root docs",
    "docs:preview": "astro preview --root docs",
    "prelint": "npm run build",
    "lint": "concurrently npm:lint:* --prefixColors auto",
    "postlint": "npm run clean",
    "lint:engines": "installed-check --engine-check",
    "lint:format": "biome check --write",
    "lint:lockfile": "lockfile-lint",
    "lint:package": "npmPkgJsonLint .",
    "lint:sort_package": "sort-package-json \"package.json\" \"packages/*/package.json\"",
    "lint:typecheck": "tsc --noEmit",
    "prepare": "husky",
    "scripts:dummy": "tsx scripts/publish-dummy-packages.ts",
    "scripts:schema": "tsx scripts/generate-schema.ts",
    "pretest": "npm run build",
    "test": "vitest run",
    "posttest": "npm run clean",
    "pretest:coverage": "npm run build",
    "test:coverage": "vitest run --coverage",
    "posttest:coverage": "npm run clean && coverage-badge-readme"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "overrides": {
    "axios": "^1.21.1",
    "minimatch": "^11.0.1"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "cosmiconfig": "^9.0.1",
    "execa": "^9.6.1",
    "jiti": "^2.7.0",
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@astrojs/starlight": "^0.42.11",
    "@biomejs/biome": "^2.6.7",
    "@bonvoy/core": "^0.12.7",
    "@commitlint/cli": "^20.4.4",
    "@commitlint/config-conventional": "^20.4.4",
    "@tsconfig/node24": "^24.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@zweer/coverage-badge-readme": "^1.4.0",
    "astro": "^7.4.11",
    "bonvoy": "^0.13.2",
    "concurrently": "^10.0.7",
    "husky": "^9.1.7",
    "installed-check": "^11.0.0",
    "lint-staged": "^17.6.0",
    "lockfile-lint": "^5.1.0",
    "memfs": "^4.80.0",
    "npm-package-json-lint": "^9.1.0",
    "npm-package-json-lint-config-default": "^8.0.1",
    "publint": "^0.3.25",
    "rimraf": "^6.1.4",
    "sort-package-json": "^4.1.0",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "unrun": "^0.3.1",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^22.23.4 || ^24.15.0 || >=26.0.0"
  },
  "lockfile-lint": {
    "path": "package-lock.json",
    "type": "npm",
    "validate-https": true,
    "allowed-hosts": [
      "npm"
    ]
  }
}
